{
  "schemaVersion": 4,
  "toolchain": { "language": "go", "version": "1.26.6" },
  "extends": ["opentofu@1"],
  "defaults": {
    "includeFamilies": [
      "feature",
      "fix",
      "docs",
      "refactor",
      "chore",
      "test",
      "perf",
      "hotfix"
    ]
  },
  "gates": [
    {
      "name": "dependency-authority-infrastructure-source-quality",
      "command": "go",
      "args": [
        "run",
        "-mod=readonly",
        "./cmd/build"
      ],
      "timeout": "15m"
    }
  ]
}

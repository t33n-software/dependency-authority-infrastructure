# Local build and test outputs.
/.build/
/dist/
/coverage/
/.cache/
*.coverprofile
*.test
*.out
*.cov

# -- project additions below this line --

# OpenTofu local state, plans and provider plugins
**/.terraform/
**/.build/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
.terraformrc
terraform.rc

# Instance bindings never live in the core
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Provider lock files are committed for the reference stacks only
modules/**/.terraform.lock.hcl
policy-bindings/.terraform.lock.hcl
